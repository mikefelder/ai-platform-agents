{
    "name": "teams-bot-toolkit",
    "version": "1.0.0",
    "description": "Microsoft Teams Toolkit hello world Bot sample",
    "engines": {
        "node": ">=22"
    },
    "author": "Microsoft",
    "license": "MIT",
    "main": "./lib/index.js",
    "scripts": {
        "dev:teamsfx": "env-cmd --silent -f .localConfigs npm run dev",
        "dev:teamsfx:testtool": "env-cmd --silent -f .localConfigs.testTool npm run dev",
        "dev:teamsfx:launch-testtool": "env-cmd --silent -f env/.env.testtool teamsapptester start",
        "dev": "nodemon --exec node --inspect=9239 --signal SIGINT -r ts-node/register ./index.ts",
        "postinstall": "node ./scripts/apply-botbuilder-zod-patch.cjs",
        "prebuild": "node ./scripts/apply-botbuilder-zod-patch.cjs --check",
        "build": "tsc --build",
        "start": "node ./lib/index.js",
        "prestart": "node ./scripts/apply-botbuilder-zod-patch.cjs --check",
        "watch": "nodemon --exec \"npm run start\"",
        "test": "npm run build && npm run test:types && node --test test/*.test.cjs",
        "test:types": "tsc --project test/tsconfig.types.json",
        "enable-sp": "node ./scripts/enable-service-principal.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com"
    },
    "dependencies": {
        "botbuilder": "4.23.3",
        "restify": "^12.0.0"
    },
    "overrides": {
        "botbuilder": {
            "uuid": "11.1.1",
            "zod": "4.6.6"
        },
        "botbuilder-core": {
            "uuid": "11.1.1",
            "zod": "4.6.6"
        },
        "botframework-schema": {
            "uuid": "11.1.1",
            "zod": "4.6.6"
        },
        "botframework-connector": {
            "zod": "4.6.6"
        },
        "botframework-streaming": {
            "uuid": "11.1.1"
        },
        "@azure/msal-node": {
            "uuid": "11.1.1"
        }
    },
    "devDependencies": {
        "@types/node": "^25.9.2",
        "@types/restify": "^8.5.5",
        "env-cmd": "^10.1.0",
        "nodemon": "^3.1.0",
        "shx": "^0.3.3",
        "ts-node": "^10.4.0",
        "typescript": "^6.0.3"
    }
}
